# Remax Forge & Fittings — Apache / LiteSpeed Web Server Configuration
Options -Indexes
DirectoryIndex index.html

ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# ----------------------------------------------------------------------
# 1. High-Performance Compression (Gzip / Deflate / Brotli)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom_xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE application/x-font-ttf
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>

# ----------------------------------------------------------------------
# 2. Browser Caching & Cache-Control (LiteSpeed & Apache)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML: always revalidate so deployments update immediately
  ExpiresByType text/html "access plus 0 seconds"

  # CSS & JavaScript (Vite hashed bundles): 1 Year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Images: 1 Month
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts: 1 Year
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # Documents / PDFs
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Immutable long-term caching for hashed Vite assets in /assets/
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML: browsers always revalidate; the CDN edge may keep a copy for 10 min (s-maxage) and
  # serve it while refreshing in the background, instead of hitting the origin on every visit
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, s-maxage=600, stale-while-revalidate=3600"
  </FilesMatch>

  # Images
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # The Udyam certificate prints the company mobile & email: keep it out of search results
  # (contact details are gated behind the quote form - see CLAUDE.md "Contact gate")
  <FilesMatch "^udyam-registration-certificate\.pdf$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>

  # Security & Performance Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "0"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------------------
# 3. Legacy 301s, Canonical HTTPS + Non-WWW, Trailing Slash & 404
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 3a. /index, /index.html -> canonical root (THE_REQUEST avoids looping on DirectoryIndex)
  RewriteCond %{THE_REQUEST} \s/index(\.html?)?[\s?] [NC]
  RewriteRule ^index(\.html?)?$ https://remaxforge.com/ [R=301,L]

  # 3c. Legacy Category & Service URLs (from GSC Coverage Audit)
  RewriteRule ^category/socket-weld-fittings/?$ https://remaxforge.com/products/socket-weld-fittings/socket-weld-coupling-fittings/ [R=301,L]
  RewriteRule ^category/butt-weld-fittings/?$ https://remaxforge.com/products/buttweld-fittings/butt-weld-elbow-fittings/ [R=301,L]
  RewriteRule ^category/plate/?$ https://remaxforge.com/product-details/boiler-quality-plate/ [R=301,L]
  RewriteRule ^category/pipe/?$ https://remaxforge.com/products/pipes/alloy-steel-pipes/ [R=301,L]
  RewriteRule ^category/tubes/?$ https://remaxforge.com/products/pipes/alloy-steel-pipes/ [R=301,L]
  RewriteRule ^service/dimension-chart/?$ https://remaxforge.com/tech-info/dimension-chart/ [R=301,L]
  RewriteRule ^service/weight-chart/?$ https://remaxforge.com/tech-info/weight-chart/ [R=301,L]
  RewriteRule ^jharkhand/dhanbad/?$ https://remaxforge.com/dhanbad/ [R=301,L]

  # 3d. Obsolete Product Lines (Round Bar, Plate types, Pipe types)
  RewriteRule ^products/round-bar/?$ https://remaxforge.com/products/flanges/ [R=301,L]
  RewriteRule ^products/round-bar/.*$ https://remaxforge.com/products/flanges/ [R=301,L]
  RewriteRule ^products/plates/?$ https://remaxforge.com/product-details/boiler-quality-plate/ [R=301,L]
  RewriteRule ^products/plates/quend-plate/?$ https://remaxforge.com/product-details/hardox-plate/ [R=301,L]
  RewriteRule ^products/plates/quard-plate/?$ https://remaxforge.com/product-details/hardox-plate/ [R=301,L]
  RewriteRule ^products/plates/hardox-plate/?$ https://remaxforge.com/product-details/hardox-plate/ [R=301,L]
  RewriteRule ^products/plates/.*$ https://remaxforge.com/product-details/boiler-quality-plate/ [R=301,L]
  RewriteRule ^products/tubes/.*$ https://remaxforge.com/products/pipes/alloy-steel-pipes/ [R=301,L]
  RewriteCond %{REQUEST_URI} !^/products/pipes/alloy-steel-pipes/?$
  RewriteRule ^products/pipes/.*$ https://remaxforge.com/products/pipes/alloy-steel-pipes/ [R=301,L]

  RewriteRule ^product-details/threaded-nipple-fitting/?$ https://remaxforge.com/products/socket-weld-fittings/socket-weld-nipple-fittings/ [R=301,L]
  RewriteRule ^product-details/threaded-elbow/?$ https://remaxforge.com/products/socket-weld-fittings/socket-weld-elbow-fittings/ [R=301,L]
  RewriteRule ^product-details/threaded-flange/?$ https://remaxforge.com/products/flanges/threaded-flange/ [R=301,L]
  RewriteRule ^product-details/quend-plates/?$ https://remaxforge.com/product-details/hardox-plate/ [R=301,L]
  RewriteRule ^product-details/offshore-steel-plate/?$ https://remaxforge.com/product-details/boiler-quality-plate/ [R=301,L]
  RewriteRule ^product-details/brass-pipes/?$ https://remaxforge.com/products/pipes/alloy-steel-pipes/ [R=301,L]
  RewriteRule ^product-details/tantalum-pipe/?$ https://remaxforge.com/products/pipes/alloy-steel-pipes/ [R=301,L]
  RewriteRule ^product-details/alloy-steel-pipes/?$ https://remaxforge.com/products/pipes/alloy-steel-pipes/ [R=301,L]

  # 3d-2. Legacy URLs reported in GSC that previously redirected into a 404
  RewriteRule ^product-details/weldneck-flange/?$ https://remaxforge.com/products/flanges/weld-neck-flange/ [R=301,L]
  RewriteRule ^product-details/(blind-flange|socket-weld-flange|slip-on-flange)/?$ https://remaxforge.com/products/flanges/$1/ [R=301,L]
  RewriteRule ^product-details/stub-end-flange/?$ https://remaxforge.com/products/flanges/lap-joint-flange/ [R=301,L]
  RewriteRule ^product-details/(socket-weld-(?:coupling|union|elbow|tee|lateral-tee|cross|cap|reducer-insert|nipple|bushing|plug)-fittings)/?$ https://remaxforge.com/products/socket-weld-fittings/$1/ [R=301,L]
  RewriteRule ^product-details/(carbon-steel-plate|nickel-alloy-plate)/?$ https://remaxforge.com/product-details/boiler-quality-plate/ [R=301,L]
  RewriteRule ^product-details/titanium-pipe/?$ https://remaxforge.com/products/pipes/alloy-steel-pipes/ [R=301,L]
  RewriteRule ^products/forged-fittings/union/?$ https://remaxforge.com/products/socket-weld-fittings/socket-weld-union-fittings/ [R=301,L]
  RewriteRule ^products/forged-fittings/bush/?$ https://remaxforge.com/products/socket-weld-fittings/socket-weld-bushing-fittings/ [R=301,L]
  RewriteRule ^products/forged-fittings/socket-weld-(elbow|tee)/?$ https://remaxforge.com/products/socket-weld-fittings/socket-weld-$1-fittings/ [R=301,L]
  RewriteRule ^products/forged-fittings/.+$ https://remaxforge.com/products/forged-fittings/ [R=301,L]
  RewriteRule ^Remax(\s|%20)Brochure\.pdf$ https://remaxforge.com/brochure/ [R=301,L]
  RewriteRule ^Remax(\s|%20)GST(\s|%20)Certificate\.pdf$ https://remaxforge.com/remax-gst-certificate.pdf [R=301,L]
  RewriteRule ^Udyam\.pdf$ https://remaxforge.com/udyam-registration-certificate.pdf [R=301,L]

  # 3d-3. Removed pages with no replacement: 410 Gone so Google drops them quickly
  RewriteRule ^(seo|product-details/spring-washer)/?$ - [G,L]

  # 3e. Parent Directory / Category Hub 301 Redirects (Fixes H1 403 Forbidden)
  RewriteRule ^products/?$ https://remaxforge.com/products/flanges/ [R=301,L]
  RewriteRule ^products/buttweld-fittings/?$ https://remaxforge.com/products/buttweld-fittings/butt-weld-elbow-fittings/ [R=301,L]
  RewriteRule ^materials/?$ https://remaxforge.com/materials/carbon-steel-flanges/ [R=301,L]
  RewriteRule ^industries/?$ https://remaxforge.com/industries/oil-and-gas/ [R=301,L]
  RewriteRule ^product-details/?$ https://remaxforge.com/product-details/boiler-quality-plate/ [R=301,L]
  RewriteRule ^tech-info/?$ https://remaxforge.com/tech-info/dimension-chart/ [R=301,L]
  RewriteRule ^tech-info/dimensions/?$ https://remaxforge.com/tech-info/dimension-chart/ [R=301,L]
  RewriteRule ^about/?$ https://remaxforge.com/about-us/ [R=301,L]
  RewriteRule ^certificates/?$ https://remaxforge.com/certification/ [R=301,L]

  # 3f. Non-Self-Canonical City Redirects (Fixes H3)
  RewriteRule ^naharlagun/?$ https://remaxforge.com/itanagar/ [R=301,L]
  RewriteRule ^pasighat/?$ https://remaxforge.com/market-area/arunachal-pradesh/ [R=301,L]
  RewriteRule ^tawang/?$ https://remaxforge.com/market-area/arunachal-pradesh/ [R=301,L]
  RewriteRule ^ziro/?$ https://remaxforge.com/market-area/arunachal-pradesh/ [R=301,L]

  # 3g. Force HTTPS & non-www. Extension-less paths get their trailing slash in
  #     the same hop so http/www variants never chain through two redirects.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/)$
  RewriteRule ^(.*)$ https://remaxforge.com/$1/ [R=301,L]

  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://remaxforge.com/$1 [R=301,L]

  # 3h. Force trailing slash on URLs without extensions
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5})$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://remaxforge.com/$1/ [R=301,L]

  # 3i. If requested URL exists as a physical file or directory with index.html, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # 3j. Fallback rule: return real HTTP 404 for unknown URLs (Fixes C3 Soft 404!)
  RewriteRule ^ - [R=404,L]
</IfModule>

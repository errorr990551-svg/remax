# Remax Forge & Fittings — Apache / LiteSpeed Web Server Configuration
Options -Indexes
DirectoryIndex index.html

ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# 1. High-Performance Compression (Gzip / Deflate / Brotli)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom_xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE application/x-font-ttf
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>

# ----------------------------------------------------------------------
# 2. Browser Caching & Cache-Control (LiteSpeed & Apache)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML: always revalidate so deployments update immediately
  ExpiresByType text/html "access plus 0 seconds"

  # CSS & JavaScript (Vite hashed bundles): 1 Year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Images: 1 Month
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts: 1 Year
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # Documents / PDFs
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Immutable long-term caching for hashed Vite assets in /assets/
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML caching policy
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Images
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # Security & Performance Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------------------
# 3. Canonical HTTPS, Non-WWW, URL Rewrites, Trailing Slash, Hubs & 404
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 3a. Force HTTPS & Non-WWW (Single canonical hop for http and www)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.remaxforge\.com$ [NC]
  RewriteRule ^(.*)$ https://remaxforge.com/$1 [R=301,L]

  # 3b. Strip index.html to avoid duplicate root/folder indexing
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/ [NC]
  RewriteRule ^index\.html$ https://remaxforge.com/ [R=301,L]

  # 3c. Legacy Category & Service URLs (from GSC Coverage Audit)
  RewriteRule ^category/socket-weld-fittings/?$ /products/socket-weld-fittings/socket-weld-coupling-fittings/ [R=301,L]
  RewriteRule ^category/butt-weld-fittings/?$ /products/buttweld-fittings/butt-weld-elbow-fittings/ [R=301,L]
  RewriteRule ^category/plate/?$ /product-details/boiler-quality-plate/ [R=301,L]
  RewriteRule ^category/pipe/?$ /products/pipes/alloy-steel-pipes/ [R=301,L]
  RewriteRule ^category/tubes/?$ /products/pipes/alloy-steel-pipes/ [R=301,L]
  RewriteRule ^service/dimension-chart/?$ /tech-info/dimension-chart/ [R=301,L]
  RewriteRule ^service/weight-chart/?$ /tech-info/weight-chart/ [R=301,L]
  RewriteRule ^jharkhand/dhanbad/?$ /dhanbad/ [R=301,L]
  RewriteRule ^udaipur-rajasthan/?$ /udaipur/ [R=301,L]
  RewriteRule ^udaipur-tripura/?$ /udaipur/ [R=301,L]

  # 3d. Obsolete Product Lines (Round Bar, Plate types, Pipe types)
  RewriteRule ^products/round-bar/?$ /products/flanges/ [R=301,L]
  RewriteRule ^products/round-bar/.*$ /products/flanges/ [R=301,L]
  RewriteRule ^products/plates/?$ /product-details/boiler-quality-plate/ [R=301,L]
  RewriteRule ^products/plates/quend-plate/?$ /product-details/hardox-plate/ [R=301,L]
  RewriteRule ^products/plates/quard-plate/?$ /product-details/hardox-plate/ [R=301,L]
  RewriteRule ^products/plates/hardox-plate/?$ /product-details/hardox-plate/ [R=301,L]
  RewriteRule ^products/plates/.*$ /product-details/boiler-quality-plate/ [R=301,L]
  RewriteRule ^products/tubes/.*$ /products/pipes/alloy-steel-pipes/ [R=301,L]
  RewriteRule ^products/pipes/.*$ /products/pipes/alloy-steel-pipes/ [R=301,L]

  RewriteRule ^product-details/threaded-nipple-fitting/?$ /products/socket-weld-fittings/socket-weld-nipple-fittings/ [R=301,L]
  RewriteRule ^product-details/threaded-elbow/?$ /products/socket-weld-fittings/socket-weld-elbow-fittings/ [R=301,L]
  RewriteRule ^product-details/threaded-flange/?$ /products/flanges/threaded-flange/ [R=301,L]
  RewriteRule ^product-details/quend-plates/?$ /product-details/hardox-plate/ [R=301,L]
  RewriteRule ^product-details/offshore-steel-plate/?$ /product-details/boiler-quality-plate/ [R=301,L]
  RewriteRule ^product-details/brass-pipes/?$ /products/pipes/alloy-steel-pipes/ [R=301,L]
  RewriteRule ^product-details/tantalum-pipe/?$ /products/pipes/alloy-steel-pipes/ [R=301,L]
  RewriteRule ^product-details/alloy-steel-pipes/?$ /products/pipes/alloy-steel-pipes/ [R=301,L]

  # 3e. Parent Directory / Category Hub 301 Redirects (Fixes H1 403 Forbidden)
  RewriteRule ^products/?$ /products/flanges/ [R=301,L]
  RewriteRule ^products/buttweld-fittings/?$ /products/buttweld-fittings/butt-weld-elbow-fittings/ [R=301,L]
  RewriteRule ^materials/?$ /materials/carbon-steel-flanges/ [R=301,L]
  RewriteRule ^industries/?$ /industries/oil-and-gas/ [R=301,L]
  RewriteRule ^product-details/?$ /product-details/boiler-quality-plate/ [R=301,L]
  RewriteRule ^tech-info/?$ /tech-info/dimension-chart/ [R=301,L]
  RewriteRule ^tech-info/dimensions/?$ /tech-info/dimension-chart/ [R=301,L]
  RewriteRule ^about/?$ /about-us/ [R=301,L]
  RewriteRule ^certificates/?$ /certification/ [R=301,L]

  # 3f. Non-Self-Canonical City Redirects (Fixes H3)
  RewriteRule ^naharlagun/?$ /itanagar/ [R=301,L]
  RewriteRule ^pasighat/?$ /market-area/arunachal-pradesh/ [R=301,L]
  RewriteRule ^tawang/?$ /market-area/arunachal-pradesh/ [R=301,L]
  RewriteRule ^ziro/?$ /market-area/arunachal-pradesh/ [R=301,L]

  # 3g. Force trailing slash on URLs without extensions
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5})$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # 3h. If requested URL exists as a physical file or directory with index.html, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # 3i. Fallback rule: return real HTTP 404 for unknown URLs (Fixes C3 Soft 404!)
  RewriteRule ^ - [R=404,L]
</IfModule>
